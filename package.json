{
  "name": "jiyu-media-center",
  "private": true,
  "version": "0.3.36",
  "description": "Jiyu — freedom-focused media center for sports, movies, anime, series, and news streams",
  "author": "Jiyu",
  "repository": {
    "type": "git",
    "url": "https://github.com/rcrdhs/jiyu-media-center.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k --success first \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pack:win": "npm run build && electron-builder --win nsis portable",
    "pack:linux": "npm run build && electron-builder --linux AppImage deb",
    "pack:tizen": "npm run build && node scripts/pack-tizen.mjs",
    "release:win": "npm run build && electron-builder --win nsis portable --publish always",
    "release:linux": "npm run build && electron-builder --linux AppImage deb --publish always"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.6.16",
    "puppeteer-core": "^25.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "webtorrent": "^3.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "app.jiyu.mediacenter",
    "productName": "Jiyu",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Jiyu"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rcrdhs",
        "repo": "jiyu-media-center",
        "releaseType": "release"
      }
    ]
  }
}
