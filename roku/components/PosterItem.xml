<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterItem" extends="Group">
  <script type="text/brightscript" uri="PosterItem.brs" />
  <interface>
    <field id="itemContent" type="node" onChange="onContentSet" />
    <field id="focusPercent" type="float" onChange="onFocusPercent" />
  </interface>
  <children>
    <!-- ~Continue-watching card: art + title + muted meta. -->
    <Rectangle
      id="focusOuter"
      width="268"
      height="228"
      translation="[0,0]"
      color="0x00000000"
    />
    <Rectangle
      id="focusRing"
      width="264"
      height="224"
      translation="[2,2]"
      color="0x00000000"
    />
    <Rectangle
      id="card"
      width="256"
      height="216"
      translation="[6,6]"
      color="0x10141AFF"
    />
    <Poster
      id="poster"
      width="256"
      height="144"
      translation="[6,6]"
      loadWidth="256"
      loadHeight="144"
      loadDisplayMode="scaleToZoom"
      failedBitmapUri=""
    />
    <Rectangle
      id="body"
      width="256"
      height="72"
      translation="[6,150]"
      color="0x10141AFF"
    />
    <Label
      id="title"
      translation="[16,154]"
      width="236"
      height="30"
      font="font:SmallBoldSystemFont"
      color="0xE8ECF4FF"
      horizAlign="left"
      vertAlign="center"
      wrap="false"
      ellipsizeOnBoundary="true"
    />
    <Label
      id="meta"
      translation="[16,182]"
      width="236"
      height="28"
      font="font:SmallSystemFont"
      color="0x8B95A8FF"
      horizAlign="left"
      vertAlign="center"
      wrap="false"
      ellipsizeOnBoundary="true"
    />
    <Rectangle
      id="liveChip"
      width="54"
      height="22"
      translation="[16,16]"
      color="0x6FDFA0FF"
      visible="false"
    />
    <Label
      id="liveLabel"
      text="LIVE"
      translation="[16,16]"
      width="54"
      height="22"
      font="font:SmallBoldSystemFont"
      color="0x0D1A12FF"
      horizAlign="center"
      vertAlign="center"
      visible="false"
    />
  </children>
</component>
